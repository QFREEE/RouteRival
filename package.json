{
  "name": "routerival-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:api": "tsx backend/simple-server.ts",
    "dev:full": "BACKEND_PORT=${BACKEND_PORT:-4001} npm run dev:api & BACKEND_ORIGIN=http://localhost:${BACKEND_PORT:-4001} npm run dev:web",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "seed:challenge": "tsx prisma/seed-challenge.ts",
    "seed:nodes": "tsx prisma/seed-nodes-from-snapshot.ts",
    "data:fetch": "tsx scripts/fetch-nyc-snapshots.ts",
    "data:build": "tsx scripts/build-nyc-map-layers.ts",
    "data:seed:nodes": "npm run seed:nodes",
    "data:snapshot": "npm run data:fetch && npm run data:build && npm run data:seed:nodes",
    "tiles:fetch:nyc": "tsx scripts/fetch-nyc-base-tiles.ts",
    "ui:screenshot": "node scripts/capture-game-screenshot.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "leaflet": "^1.9.4",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.58.2",
    "prisma": "^6.16.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
